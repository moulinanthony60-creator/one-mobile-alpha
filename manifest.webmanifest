{
  "id": "/one-mobile-alpha/",
  "name": "ONE Mobile Alpha 0.11.3",
  "short_name": "ONE",
  "description": "ONE — feed multi-plateformes et cible de partage Android TikTok via POST.",
  "start_url": "/one-mobile-alpha/",
  "scope": "/one-mobile-alpha/",
  "display": "standalone",
  "background_color": "#07090d",
  "theme_color": "#07090d",
  "orientation": "portrait-primary",
  "lang": "fr",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/one-mobile-alpha/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/one-mobile-alpha/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/one-mobile-alpha/share-target",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  }
}
